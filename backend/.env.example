# Database (SQLite file, zero setup — swap for a Postgres URL later)
DATABASE_URL=sqlite:///./honeychain.db

# Frontend origin allowed to call this API
FRONTEND_ORIGIN=http://localhost:3000

# Shared secret required (as an X-API-Key header) for write endpoints
# (POST /batches, POST /batches/{id}/events) and all /admin/* routes.
# Change this for anything beyond local dev/demo use.
API_KEY=dev-local-key

# --- Blockchain ---
# Defaults below point at a LOCAL Hardhat chain (`npx hardhat node`, run from
# Honey-Chain/contracts, then `npm run deploy:local`) — no wallet or signup
# needed, see Honey-Chain/contracts/README.md. The node must be running for
# these calls to work; if you'd rather skip it, blank out the three
# connection variables below and app/blockchain.py falls back to the
# zero-setup stub automatically.
#
# Account #0 and this contract address are Hardhat's well-known, publicly
# documented local dev defaults — never used for anything but this local
# chain, safe to keep in a template file.
POLYGON_RPC_URL=http://127.0.0.1:8545
POLYGON_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
POLYGON_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
POLYGON_NETWORK_NAME=Hardhat Local
POLYGON_CHAIN_ID=31337

# To point at the public Polygon Amoy testnet instead (persistent deployment,
# real Polygonscan link — see contracts/README.md for the wallet/faucet/RPC
# steps), replace the five values above with your own RPC URL, wallet
# private key, and deployed contract address, and set:
# POLYGON_NETWORK_NAME=Polygon Amoy
# POLYGON_CHAIN_ID=80002
