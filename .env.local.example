# URL of the Honey Chain FastAPI backend (see backend/README.md)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side only (no NEXT_PUBLIC_ prefix — never shipped to the browser).
# Must match backend/.env's API_KEY. Attached automatically by server
# components and by app/api/batches/route.ts, which proxies the one
# client-side write (batch creation) so this key never reaches the browser.
HONEYCHAIN_API_KEY=dev-local-key
